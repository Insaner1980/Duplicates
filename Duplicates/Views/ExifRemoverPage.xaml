<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duplicates.Views.ExifRemoverPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Duplicates.Views.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Page.Resources>
        <DataTemplate x:Key="ExifResultTemplate">
            <Grid Padding="8,10" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="{Binding SourcePath}"
                    TextWrapping="Wrap"
                    ToolTipService.ToolTip="{Binding SourcePath}" />
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource MutedTextBlockStyle}"
                    Text="{Binding Outcome}" />
                <TextBlock
                    Grid.Row="2"
                    Text="{Binding Detail}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Grid.Row="3"
                    Style="{StaticResource PathTextBlockStyle}"
                    Text="{Binding OutputPath}"
                    TextWrapping="Wrap"
                    ToolTipService.ToolTip="{Binding OutputPath}" />
                <StackPanel Grid.Row="4" Spacing="{StaticResource SpacingSmall}">
                    <TextBlock
                        Style="{StaticResource PathTextBlockStyle}"
                        Text="{Binding RecoveryPathsText}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpacingSmall}"
                        Visibility="{Binding OutputActionsVisibility}">
                        <Button
                            AutomationProperties.Name="Open cleaned image"
                            Command="{Binding DataContext.OpenOutputCommand, ElementName=PageRoot}"
                            CommandParameter="{Binding}"
                            Content="Open" />
                        <Button
                            AutomationProperties.Name="Reveal cleaned image in Explorer"
                            Command="{Binding DataContext.RevealOutputCommand, ElementName=PageRoot}"
                            CommandParameter="{Binding}"
                            Content="Reveal in Explorer" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <Grid
                MaxWidth="{StaticResource ContentMaxWidth}"
                Padding="{StaticResource ScrollingPageContentPadding}"
                HorizontalAlignment="Stretch">
                <StackPanel Spacing="{StaticResource SpacingExtraLarge}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="EXIF remover" />
                        <TextBlock
                            Style="{StaticResource MutedTextBlockStyle}"
                            Text="Remove personal image metadata without re-encoding pixels."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <InfoBar
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="EXIF cleaning status"
                        IsOpen="{Binding IsStatusOpen}"
                        Message="{Binding StatusMessage}"
                        Severity="{Binding StatusSeverity}" />

                    <controls:PathScopeEditor
                        x:Name="PathScopeEditor"
                        DataContext="{Binding PathScope}"
                        FileTypeFilter=".jpg,.jpeg,.tif,.tiff" />

                    <toolkit:SettingsExpander
                        Header="Privacy options"
                        Description="Choose which metadata is removed from each image."
                        IsExpanded="True">
                        <toolkit:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE72E;" />
                        </toolkit:SettingsExpander.HeaderIcon>
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard
                                Header="Remove GPS location">
                                <ToggleSwitch
                                    AutomationProperties.Name="Remove GPS location"
                                    IsOn="{Binding RemoveGps, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Remove camera and lens identifiers">
                                <ToggleSwitch
                                    AutomationProperties.Name="Remove camera and lens identifiers"
                                    IsOn="{Binding RemoveDeviceIdentifiers, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Remove dates and times">
                                <ToggleSwitch
                                    AutomationProperties.Name="Remove dates and times"
                                    IsOn="{Binding RemoveDates, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Remove author and description">
                                <ToggleSwitch
                                    AutomationProperties.Name="Remove author and description"
                                    IsOn="{Binding RemoveAuthorAndDescription, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Remove embedded thumbnail">
                                <ToggleSwitch
                                    AutomationProperties.Name="Remove embedded thumbnail"
                                    IsOn="{Binding RemoveEmbeddedThumbnail, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Remove XMP and IPTC metadata">
                                <ToggleSwitch
                                    AutomationProperties.Name="Remove XMP and IPTC metadata"
                                    IsOn="{Binding RemoveXmpAndIptc, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Replace original after verification"
                                Description="Otherwise a cleaned copy is saved next to the original.">
                                <ToggleSwitch
                                    AutomationProperties.Name="Replace original after verification"
                                    IsOn="{Binding ReplaceOriginal, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                        <toolkit:SettingsExpander.ItemsFooter>
                            <InfoBar
                                IsClosable="False"
                                IsOpen="{Binding ReplaceOriginal}"
                                Message="The verified cleaned image will replace the original. The original is sent to the Recycle Bin only after replacement succeeds."
                                Severity="Warning" />
                        </toolkit:SettingsExpander.ItemsFooter>
                    </toolkit:SettingsExpander>

                    <StackPanel
                        AutomationProperties.LiveSetting="Polite"
                        Spacing="{StaticResource SpacingMedium}"
                        Visibility="{Binding ProgressVisibility}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderTextBlockStyle}"
                            Text="Cleaning progress" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Overall progress" />
                        <ProgressBar Maximum="100" Value="{Binding ProgressValue}" />
                        <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Current image" />
                        <ProgressBar Maximum="100" Value="{Binding CurrentFileProgress}" />
                        <TextBlock
                            Style="{StaticResource PathTextBlockStyle}"
                            Text="{Binding CurrentPath}"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{Binding CurrentPath}" />
                        <Button
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Cancel image cleaning"
                            Command="{Binding CancelCleaningCommand}"
                            IsEnabled="{Binding IsCleaning}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                                <SymbolIcon Symbol="Cancel" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingMedium}" Visibility="{Binding ResultsVisibility}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderTextBlockStyle}"
                            Text="Results" />
                        <ListView
                            AutomationProperties.Name="EXIF cleaning results"
                            ItemTemplate="{StaticResource ExifResultTemplate}"
                            ItemsSource="{Binding Results}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="ActionFooter"
            Grid.Row="1"
            Style="{StaticResource PageFooterBorderStyle}">
            <Grid
                MaxWidth="{StaticResource ContentMaxWidth}"
                HorizontalAlignment="Stretch"
                ColumnSpacing="{StaticResource SpacingLarge}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource MutedTextBlockStyle}"
                    Text="Add at least one folder or file to start."
                    Visibility="{Binding PathScope.EmptyIncludedPathsVisibility}" />
                <Button
                    Grid.Column="1"
                    AccessKey="C"
                    AutomationProperties.Name="Clean images"
                    Click="CleanImages_Click"
                    IsEnabled="{Binding CanStartCleaning}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                        <SymbolIcon Symbol="Accept" />
                        <TextBlock Text="Clean images" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
