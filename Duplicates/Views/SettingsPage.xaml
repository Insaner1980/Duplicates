<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duplicates.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Duplicates.Views.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Loaded="SettingsPage_Loaded">
    <Grid Background="{ThemeResource BgBaseBrush}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <Grid
                MaxWidth="{StaticResource ContentMaxWidth}"
                Padding="{StaticResource ScrollingPageContentPadding}"
                HorizontalAlignment="Stretch">
                <StackPanel Spacing="{StaticResource SpacingMedium}">
                    <StackPanel Margin="0,0,0,12" Spacing="6">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="Settings" />
                        <TextBlock
                            Style="{StaticResource MutedTextBlockStyle}"
                            Text="Defaults are saved locally. Scan folders and results are not stored." />
                    </StackPanel>

                    <toolkit:SettingsExpander
                        Header="Appearance"
                        Description="Theme and window material."
                        IsExpanded="True">
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard
                                Header="Theme"
                                Description="Follow Windows or choose a fixed light or dark appearance.">
                                <ComboBox
                                    MinWidth="180"
                                    ItemsSource="{Binding ThemeModes}"
                                    SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Window background"
                                Description="Choose the material used behind the app content.">
                                <ComboBox
                                    MinWidth="180"
                                    AutomationProperties.Name="Window background"
                                    SelectedIndex="{Binding SelectedBackdropModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Mica" />
                                    <ComboBoxItem Content="Mica Alt" />
                                    <ComboBoxItem Content="Acrylic" />
                                    <ComboBoxItem Content="Solid" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <toolkit:SettingsExpander
                        Header="Scanning defaults"
                        Description="Used when a new scan page is opened."
                        IsExpanded="False">
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard
                                Header="Default minimum file size"
                                Description="Skip files smaller than this value.">
                                <StackPanel Spacing="{StaticResource SpacingSmall}">
                                    <controls:ByteSizeBox
                                        AccessibleName="Default minimum file size"
                                        DataContext="{Binding DefaultMinSizeEditor}" />
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                                        <Button
                                            Content="Any"
                                            Command="{Binding UseAnySizeDefaultCommand}" />
                                        <Button
                                            Content="1 KB+"
                                            Command="{Binding UseOneKilobyteDefaultCommand}" />
                                        <Button
                                            Content="1 MB+"
                                            Command="{Binding UseOneMegabyteDefaultCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Verify byte-by-byte"
                                Description="Confirm matching hashes by comparing the complete file contents.">
                                <ToggleSwitch
                                    AutomationProperties.Name="Verify byte-by-byte"
                                    IsOn="{Binding VerifyByteByByte, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Ignore hidden files"
                                Description="Exclude files marked as hidden by Windows.">
                                <ToggleSwitch
                                    AutomationProperties.Name="Ignore hidden files"
                                    IsOn="{Binding IgnoreHiddenFiles, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Ignore system files"
                                Description="Exclude protected operating system files.">
                                <ToggleSwitch
                                    AutomationProperties.Name="Ignore system files"
                                    IsOn="{Binding IgnoreSystemFiles, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Include subfolders"
                                Description="Include folders below each selected folder by default.">
                                <ToggleSwitch
                                    AutomationProperties.Name="Include subfolders by default"
                                    IsOn="{Binding DefaultIncludeSubfolders, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Hashing concurrency"
                                Description="Control how many files can be hashed at the same time.">
                                <ComboBox
                                    MinWidth="180"
                                    ItemsSource="{Binding ConcurrencyOptions}"
                                    SelectedIndex="{Binding SelectedConcurrencyIndex, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Big-file threshold"
                                Description="Default minimum size for Big files.">
                                <controls:ByteSizeBox
                                    AccessibleName="Default big-file minimum size"
                                    DataContext="{Binding DefaultLargeFileMinimumEditor}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Temporary-file minimum age"
                                Description="Default minimum age in days for Temporary files.">
                                <NumberBox
                                    MinWidth="220"
                                    AutomationProperties.Name="Default temporary-file minimum age in days"
                                    Maximum="365"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValidationMode="InvalidInputOverwritten"
                                    Value="{Binding DefaultTemporaryFileMinimumAgeDays, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <toolkit:SettingsExpander
                        Header="Similarity and media"
                        Description="Matching sensitivity, media work, and the fingerprint cache."
                        IsExpanded="False">
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard
                                Header="Image similarity"
                                Description="Choose the default image-matching sensitivity.">
                                <ComboBox
                                    MinWidth="180"
                                    AutomationProperties.Name="Default image similarity"
                                    ItemsSource="{Binding SimilarityPresets}"
                                    SelectedItem="{Binding DefaultImageSimilarity, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Video similarity"
                                Description="Choose the default video-matching sensitivity.">
                                <ComboBox
                                    MinWidth="180"
                                    AutomationProperties.Name="Default video similarity"
                                    ItemsSource="{Binding SimilarityPresets}"
                                    SelectedItem="{Binding DefaultVideoSimilarity, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Media processing concurrency"
                                Description="Auto uses up to two workers based on this device.">
                                <ComboBox
                                    MinWidth="180"
                                    AutomationProperties.Name="Media processing concurrency"
                                    ItemsSource="{Binding MediaConcurrencyOptions}"
                                    SelectedIndex="{Binding SelectedMediaConcurrencyIndex, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Use media fingerprint cache"
                                Description="Reuse valid image and video fingerprints between scans.">
                                <ToggleSwitch
                                    AutomationProperties.Name="Use media fingerprint cache"
                                    IsOn="{Binding UseMediaFingerprintCache, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard Header="Cache status">
                                <toolkit:SettingsCard.Description>
                                    <TextBlock
                                        AutomationProperties.Name="{Binding CachePath}"
                                        Text="{Binding CachePath}"
                                        TextWrapping="Wrap" />
                                </toolkit:SettingsCard.Description>
                                <StackPanel Spacing="{StaticResource SpacingSmall}">
                                    <TextBlock
                                        AutomationProperties.LiveSetting="Polite"
                                        AutomationProperties.Name="{Binding CacheStatusText}"
                                        Text="{Binding CacheStatusText}" />
                                    <Button
                                        AutomationProperties.Name="Clear media fingerprint cache"
                                        Command="{Binding ClearCacheCommand}"
                                        Content="Clear cache" />
                                </StackPanel>
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <toolkit:SettingsExpander
                        Header="File actions"
                        Description="Deletion defaults are intentionally conservative."
                        IsExpanded="False">
                        <toolkit:SettingsExpander.Items>
                            <toolkit:SettingsCard
                                Header="Default action"
                                Description="Recycle Bin is recommended because deleted files can be restored.">
                                <ComboBox
                                    MinWidth="180"
                                    AutomationProperties.Name="Default delete action"
                                    SelectedIndex="{Binding SelectedDeletionModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Recycle Bin" />
                                    <ComboBoxItem Content="Permanent delete" />
                                </ComboBox>
                            </toolkit:SettingsCard>
                            <toolkit:SettingsCard
                                Header="Confirm before deleting"
                                Description="Review the operation before selected duplicates are removed.">
                                <ToggleSwitch
                                    AutomationProperties.Name="Confirm before deleting"
                                    IsOn="{Binding ConfirmBeforeDelete, Mode=TwoWay}" />
                            </toolkit:SettingsCard>
                        </toolkit:SettingsExpander.Items>
                    </toolkit:SettingsExpander>

                    <InfoBar
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="Settings operation status"
                        IsOpen="{Binding IsSettingsInfoOpen}"
                        Message="{Binding SettingsInfoMessage}"
                        Severity="{Binding SettingsInfoSeverity}" />

                    <InfoBar
                        AutomationProperties.Name="Permanent deletion warning"
                        IsClosable="False"
                        IsOpen="True"
                        Message="Permanent delete bypasses the Recycle Bin and cannot be undone."
                        Severity="Warning"
                        Visibility="{Binding PermanentDeleteWarningVisibility}" />

                    <toolkit:SettingsCard
                        Margin="0,12,0,0"
                        Header="About"
                        Description="{Binding AboutText}">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE946;" />
                        </toolkit:SettingsCard.HeaderIcon>
                    </toolkit:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
