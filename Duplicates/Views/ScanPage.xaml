<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duplicates.Views.ScanPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Duplicates.Views.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Grid Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <Grid
                MaxWidth="{StaticResource ContentMaxWidth}"
                Padding="{StaticResource ScrollingPageContentPadding}"
                HorizontalAlignment="Stretch">
                <StackPanel Spacing="{StaticResource SpacingExtraLarge}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="Scan for duplicates" />
                        <TextBlock
                            Style="{StaticResource MutedTextBlockStyle}"
                            Text="Choose folders and compare files by exact byte content." />
                    </StackPanel>

                    <InfoBar
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="Scan status"
                        IsOpen="{Binding IsStatusOpen}"
                        Message="{Binding StatusMessage}"
                        Severity="Informational" />

                    <StackPanel
                        Visibility="{Binding SetupVisibility}"
                        Spacing="{StaticResource SpacingExtraLarge}">
                        <controls:PathScopeEditor
                            x:Name="PathScopeEditor"
                            DataContext="{Binding PathScope}" />

                        <StackPanel Spacing="4">
                            <toolkit:SettingsExpander
                                x:Name="ScanOptions"
                                Header="Scan options"
                                Description="Choose which files are compared."
                                IsExpanded="True">
                                <toolkit:SettingsExpander.HeaderIcon>
                                    <FontIcon Glyph="&#xE71C;" />
                                </toolkit:SettingsExpander.HeaderIcon>
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard
                                        Header="Include subfolders"
                                        Description="Scan every folder below the included folders.">
                                        <ToggleSwitch
                                            AutomationProperties.Name="Include subfolders"
                                            IsOn="{Binding PathScope.IncludeSubfolders, Mode=TwoWay}" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        Header="File types"
                                        Description="Limit the scan to selected kinds of files.">
                                        <ComboBox
                                            MinWidth="200"
                                            AutomationProperties.Name="File types"
                                            SelectedIndex="{Binding SelectedFileFilterIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="All files" />
                                            <ComboBoxItem Content="Categories" />
                                            <ComboBoxItem Content="Custom extensions" />
                                        </ComboBox>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        Header="Categories"
                                        Visibility="{Binding CategoryFiltersVisibility}">
                                        <VariableSizedWrapGrid
                                            Orientation="Horizontal"
                                            MaximumRowsOrColumns="3">
                                            <CheckBox Content="Images" IsChecked="{Binding ImagesSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Video" IsChecked="{Binding VideoSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Audio" IsChecked="{Binding AudioSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Documents" IsChecked="{Binding DocumentsSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Archives" IsChecked="{Binding ArchivesSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Code" IsChecked="{Binding CodeSelected, Mode=TwoWay}" />
                                        </VariableSizedWrapGrid>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        Header="Custom extensions"
                                        Description="Separate extensions with commas."
                                        Visibility="{Binding CustomExtensionsVisibility}">
                                        <TextBox
                                            MinWidth="200"
                                            AutomationProperties.Name="Custom extensions"
                                            PlaceholderText="psd, ai, sketch"
                                            Text="{Binding CustomExtensionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        Header="Minimum size"
                                        Description="Smaller files are skipped.">
                                        <StackPanel Spacing="{StaticResource SpacingSmall}">
                                            <controls:ByteSizeBox
                                                AccessibleName="Minimum size"
                                                DataContext="{Binding MinSizeEditor}" />
                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                                                <Button Content="Any" Command="{Binding UseAnySizeCommand}" />
                                                <Button Content="1 KB+" Command="{Binding UseOneKilobyteMinimumCommand}" />
                                                <Button Content="1 MB+" Command="{Binding UseOneMegabyteMinimumCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        Header="Maximum size"
                                        Description="Leave empty for no limit.">
                                        <controls:ByteSizeBox
                                            AccessibleName="Maximum size"
                                            DataContext="{Binding MaxSizeEditor}"
                                            PlaceholderText="No cap" />
                                    </toolkit:SettingsCard>
                                </toolkit:SettingsExpander.Items>
                            </toolkit:SettingsExpander>

                            <toolkit:SettingsExpander
                                Header="Advanced options"
                                Description="Skip protected files and control verification.">
                                <toolkit:SettingsExpander.HeaderIcon>
                                    <FontIcon Glyph="&#xE713;" />
                                </toolkit:SettingsExpander.HeaderIcon>
                                <toolkit:SettingsExpander.Items>
                                    <toolkit:SettingsCard Header="Ignore hidden files">
                                        <ToggleSwitch
                                            AutomationProperties.Name="Ignore hidden files"
                                            IsOn="{Binding PathScope.IgnoreHiddenFiles, Mode=TwoWay}" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard Header="Ignore system files">
                                        <ToggleSwitch
                                            AutomationProperties.Name="Ignore system files"
                                            IsOn="{Binding PathScope.IgnoreSystemFiles, Mode=TwoWay}" />
                                    </toolkit:SettingsCard>
                                    <toolkit:SettingsCard
                                        Header="Verify byte-by-byte"
                                        Description="Compare complete file contents before reporting duplicates.">
                                        <ToggleSwitch
                                            AutomationProperties.Name="Verify byte-by-byte"
                                            IsOn="{Binding VerifyByteByByte, Mode=TwoWay}" />
                                    </toolkit:SettingsCard>
                                </toolkit:SettingsExpander.Items>
                            </toolkit:SettingsExpander>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        AutomationProperties.LiveSetting="Polite"
                        Visibility="{Binding ProgressVisibility}"
                        Spacing="{StaticResource SpacingLarge}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderTextBlockStyle}"
                            Text="{Binding PhaseText}" />
                        <ProgressBar
                            Maximum="100"
                            IsIndeterminate="{Binding IsProgressIndeterminate}"
                            Value="{Binding ProgressValue}" />
                        <VariableSizedWrapGrid Orientation="Horizontal">
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Discovered" />
                                <TextBlock Text="{Binding FilesDiscoveredText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Processed" />
                                <TextBlock Text="{Binding FilesProcessedText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Data" />
                                <TextBlock Text="{Binding BytesProcessedText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Elapsed" />
                                <TextBlock Text="{Binding ElapsedText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="ETA" />
                                <TextBlock Text="{Binding EtaText}" />
                            </StackPanel>
                        </VariableSizedWrapGrid>
                        <TextBlock Style="{StaticResource PathTextBlockStyle}" Text="{Binding CurrentFilePath}" />
                        <Button
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Cancel scan"
                            Command="{Binding CancelScanCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                                <SymbolIcon Symbol="Cancel" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="ActionFooter"
            Grid.Row="1"
            Style="{StaticResource PageFooterBorderStyle}"
            Visibility="{Binding SetupVisibility}">
            <Grid
                MaxWidth="{StaticResource ContentMaxWidth}"
                HorizontalAlignment="Stretch"
                ColumnSpacing="{StaticResource SpacingLarge}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource MutedTextBlockStyle}"
                    Text="Add at least one folder or file to start."
                    Visibility="{Binding PathScope.EmptyIncludedPathsVisibility}" />
                <Button
                    Grid.Column="1"
                    AccessKey="S"
                    AutomationProperties.Name="Start scan"
                    Command="{Binding StartScanCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="Start scan" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
