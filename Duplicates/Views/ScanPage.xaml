<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duplicates.Views.ScanPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Duplicates.Views.Controls">
    <Grid Background="{ThemeResource BgBaseBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderActionRail.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Large">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="OptionsRightColumn.Width" Value="*" />
                        <Setter Target="OptionsSecondRow.Height" Value="0" />
                        <Setter Target="SizeInputsGrid.(Grid.Column)" Value="1" />
                        <Setter Target="SizeInputsGrid.(Grid.Row)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            MaxWidth="{StaticResource ContentMaxWidth}"
            Padding="{StaticResource PageHeaderPadding}"
            HorizontalAlignment="Stretch"
            ColumnSpacing="{StaticResource SpacingLarge}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    Text="Scan for duplicates" />
                <TextBlock
                    Style="{StaticResource MutedTextBlockStyle}"
                    Text="Choose folders and compare files by exact byte content." />
            </StackPanel>
            <Grid
                x:Name="HeaderActionRail"
                Grid.ColumnSpan="2"
                MaxWidth="{StaticResource ScanWorkAreaMaxWidth}"
                HorizontalAlignment="Stretch">
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AccessKey="S"
                    AutomationProperties.Name="Start scan"
                    Command="{Binding StartScanCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{Binding SetupVisibility}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="Start scan" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <Grid
                MaxWidth="{StaticResource ContentMaxWidth}"
                Padding="{StaticResource PageContentPadding}"
                HorizontalAlignment="Stretch">
                <StackPanel Spacing="{StaticResource SpacingExtraLarge}">
                    <InfoBar
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="Scan status"
                        IsOpen="{Binding IsStatusOpen}"
                        Message="{Binding StatusMessage}"
                        Severity="Informational" />

                    <StackPanel
                        Visibility="{Binding SetupVisibility}"
                        Spacing="{StaticResource SpacingExtraLarge}">
                        <controls:PathScopeEditor
                            x:Name="PathScopeEditor"
                            MaxWidth="{StaticResource ScanWorkAreaMaxWidth}"
                            HorizontalAlignment="Stretch"
                            DataContext="{Binding PathScope}" />

                        <Expander
                            x:Name="ScanOptions"
                            MaxWidth="{StaticResource ScanWorkAreaMaxWidth}"
                            HorizontalAlignment="Stretch"
                            Header="Scan options"
                            IsExpanded="True">
                            <StackPanel Padding="0,12,0,0" Spacing="{StaticResource SpacingLarge}">
                                <Grid
                                    x:Name="OptionsGrid"
                                    ColumnSpacing="{StaticResource SpacingExtraLarge}"
                                    RowSpacing="{StaticResource SpacingLarge}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="OptionsRightColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition x:Name="OptionsSecondRow" Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Spacing="{StaticResource SpacingMedium}">
                                        <CheckBox
                                            Content="Include subfolders"
                                            IsChecked="{Binding PathScope.IncludeSubfolders, Mode=TwoWay}" />
                                        <ComboBox
                                            Header="File types"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="{Binding SelectedFileFilterIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="All files" />
                                            <ComboBoxItem Content="Categories" />
                                            <ComboBoxItem Content="Custom extensions" />
                                        </ComboBox>
                                        <VariableSizedWrapGrid
                                            Orientation="Horizontal"
                                            MaximumRowsOrColumns="3"
                                            Visibility="{Binding CategoryFiltersVisibility}">
                                            <CheckBox Content="Images" IsChecked="{Binding ImagesSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Video" IsChecked="{Binding VideoSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Audio" IsChecked="{Binding AudioSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Documents" IsChecked="{Binding DocumentsSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Archives" IsChecked="{Binding ArchivesSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Code" IsChecked="{Binding CodeSelected, Mode=TwoWay}" />
                                        </VariableSizedWrapGrid>
                                        <TextBox
                                            Header="Custom extensions"
                                            PlaceholderText="psd, ai, sketch"
                                            Visibility="{Binding CustomExtensionsVisibility}"
                                            Text="{Binding CustomExtensionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="SizeInputsGrid"
                                        Grid.Row="1"
                                        Spacing="{StaticResource SpacingMedium}">
                                        <Grid ColumnSpacing="{StaticResource SpacingMedium}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox
                                                Header="Minimum size, bytes"
                                                Minimum="0"
                                                SpinButtonPlacementMode="Compact"
                                                ValidationMode="InvalidInputOverwritten"
                                                Value="{Binding MinSizeValue, Mode=TwoWay}" />
                                            <NumberBox
                                                Grid.Column="1"
                                                Header="Maximum size, bytes"
                                                Minimum="0"
                                                PlaceholderText="No cap"
                                                SpinButtonPlacementMode="Compact"
                                                ValidationMode="InvalidInputOverwritten"
                                                Value="{Binding MaxSizeValue, Mode=TwoWay}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                                            <Button Content="Any" Command="{Binding UseAnySizeCommand}" />
                                            <Button Content="1 KB+" Command="{Binding UseOneKilobyteMinimumCommand}" />
                                            <Button Content="1 MB+" Command="{Binding UseOneMegabyteMinimumCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Expander Header="Advanced options">
                                    <StackPanel Padding="0,8,0,0" Spacing="{StaticResource SpacingSmall}">
                                        <CheckBox
                                            Content="Ignore hidden files"
                                            IsChecked="{Binding PathScope.IgnoreHiddenFiles, Mode=TwoWay}" />
                                        <CheckBox
                                            Content="Ignore system files"
                                            IsChecked="{Binding PathScope.IgnoreSystemFiles, Mode=TwoWay}" />
                                        <CheckBox
                                            Content="Verify byte-by-byte before reporting duplicates"
                                            IsChecked="{Binding VerifyByteByByte, Mode=TwoWay}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <StackPanel
                        AutomationProperties.LiveSetting="Polite"
                        Visibility="{Binding ProgressVisibility}"
                        Spacing="{StaticResource SpacingLarge}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderTextBlockStyle}"
                            Text="{Binding PhaseText}" />
                        <ProgressBar
                            Maximum="100"
                            IsIndeterminate="{Binding IsProgressIndeterminate}"
                            Value="{Binding ProgressValue}" />
                        <VariableSizedWrapGrid Orientation="Horizontal">
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Discovered" />
                                <TextBlock Text="{Binding FilesDiscoveredText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Processed" />
                                <TextBlock Text="{Binding FilesProcessedText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Data" />
                                <TextBlock Text="{Binding BytesProcessedText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Elapsed" />
                                <TextBlock Text="{Binding ElapsedText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="ETA" />
                                <TextBlock Text="{Binding EtaText}" />
                            </StackPanel>
                        </VariableSizedWrapGrid>
                        <TextBlock Style="{StaticResource PathTextBlockStyle}" Text="{Binding CurrentFilePath}" />
                        <Button
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Cancel scan"
                            Command="{Binding CancelScanCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                                <SymbolIcon Symbol="Cancel" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
