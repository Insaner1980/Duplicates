<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duplicates.Views.ScanPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            MaxWidth="{StaticResource ContentMaxWidth}"
            Padding="{StaticResource PageHeaderPadding}"
            HorizontalAlignment="Stretch"
            ColumnSpacing="{StaticResource SpacingLarge}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Foreground="{ThemeResource TextPrimaryBrush}"
                    Text="Scan for duplicates" />
                <TextBlock
                    Style="{StaticResource MutedTextBlockStyle}"
                    Text="Choose folders and compare files by exact byte content." />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Command="{Binding StartScanCommand}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{Binding SetupVisibility}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                    <SymbolIcon Symbol="Play" />
                    <TextBlock Text="Start scan" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <Grid
                MaxWidth="{StaticResource ContentMaxWidth}"
                Padding="{StaticResource PageContentPadding}"
                HorizontalAlignment="Stretch">
                <StackPanel Spacing="{StaticResource SpacingExtraLarge}">
                    <InfoBar
                        IsOpen="{Binding IsStatusOpen}"
                        Message="{Binding StatusMessage}"
                        Severity="Informational" />

                    <StackPanel Visibility="{Binding SetupVisibility}" Spacing="{StaticResource SpacingExtraLarge}">
                        <Border
                            x:Name="FoldersCard"
                            Style="{StaticResource CardBorderStyle}"
                            AllowDrop="True"
                            DragOver="FoldersCard_DragOver"
                            Drop="FoldersCard_Drop">
                            <StackPanel Spacing="{StaticResource SpacingLarge}">
                                <Grid ColumnSpacing="{StaticResource SpacingMedium}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            Foreground="{ThemeResource TextPrimaryBrush}"
                                            Text="Folders" />
                                        <TextBlock
                                            Style="{StaticResource MutedTextBlockStyle}"
                                            Text="Drop folders here or choose one or more locations to scan." />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="AddFolder_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                                            <SymbolIcon Symbol="Add" />
                                            <TextBlock Text="Add folder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ListView
                                    MaxHeight="{StaticResource FolderListMaxHeight}"
                                    ItemsSource="{Binding Folders}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="4" ColumnSpacing="{StaticResource SpacingMedium}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource PathTextBlockStyle}"
                                                    Text="{Binding}"
                                                    ToolTipService.ToolTip="{Binding}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Command="{Binding ViewModel.RemoveFolderCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="Remove folder">
                                                    <SymbolIcon Symbol="Cancel" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Spacing="{StaticResource SpacingSmall}"
                                    Visibility="{Binding EmptyFoldersVisibility}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="28"
                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                        Glyph="&#xE8B7;" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                        Text="No folders added" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource MutedTextBlockStyle}"
                                        Text="Drop a folder anywhere in this panel to begin." />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="{StaticResource SpacingLarge}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="Scan options" />
                                    <TextBlock
                                        Style="{StaticResource MutedTextBlockStyle}"
                                        Text="Set the file range and content included in this scan." />
                                </StackPanel>

                                <Grid ColumnSpacing="{StaticResource SpacingExtraLarge}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="{StaticResource SpacingMedium}">
                                        <CheckBox
                                            Content="Include subfolders"
                                            IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}" />
                                        <ComboBox
                                            Header="File types"
                                            HorizontalAlignment="Stretch"
                                            SelectedIndex="{Binding SelectedFileFilterIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="All files" />
                                            <ComboBoxItem Content="Categories" />
                                            <ComboBoxItem Content="Custom extensions" />
                                        </ComboBox>
                                        <WrapGrid
                                            Orientation="Horizontal"
                                            MaximumRowsOrColumns="3"
                                            Visibility="{Binding CategoryFiltersVisibility}">
                                            <CheckBox Content="Images" IsChecked="{Binding ImagesSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Video" IsChecked="{Binding VideoSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Audio" IsChecked="{Binding AudioSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Documents" IsChecked="{Binding DocumentsSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Archives" IsChecked="{Binding ArchivesSelected, Mode=TwoWay}" />
                                            <CheckBox Content="Code" IsChecked="{Binding CodeSelected, Mode=TwoWay}" />
                                        </WrapGrid>
                                        <TextBox
                                            Header="Custom extensions"
                                            PlaceholderText="psd, ai, sketch"
                                            Visibility="{Binding CustomExtensionsVisibility}"
                                            Text="{Binding CustomExtensionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingMedium}">
                                        <Grid ColumnSpacing="{StaticResource SpacingMedium}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                Header="Minimum size, bytes"
                                                Text="{Binding MinSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox
                                                Grid.Column="1"
                                                Header="Maximum size, bytes"
                                                PlaceholderText="No cap"
                                                Text="{Binding MaxSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                                            <Button
                                                Content="Any"
                                                Command="{Binding UseAnySizeCommand}" />
                                            <Button
                                                Content="1 KB+"
                                                Command="{Binding UseOneKilobyteMinimumCommand}" />
                                            <Button
                                                Content="1 MB+"
                                                Command="{Binding UseOneMegabyteMinimumCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Expander Header="Advanced options">
                                    <StackPanel Padding="0,8,0,0" Spacing="{StaticResource SpacingSmall}">
                                        <CheckBox
                                            Content="Ignore hidden files"
                                            IsChecked="{Binding IgnoreHiddenFiles, Mode=TwoWay}" />
                                        <CheckBox
                                            Content="Ignore system files"
                                            IsChecked="{Binding IgnoreSystemFiles, Mode=TwoWay}" />
                                        <CheckBox
                                            Content="Verify byte-by-byte before reporting duplicates"
                                            IsChecked="{Binding VerifyByteByByte, Mode=TwoWay}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="{Binding ProgressVisibility}">
                        <StackPanel Spacing="{StaticResource SpacingLarge}">
                            <TextBlock
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text="{Binding PhaseText}" />
                            <ProgressBar
                                Maximum="100"
                                IsIndeterminate="{Binding IsProgressIndeterminate}"
                                Value="{Binding ProgressValue}" />
                            <Grid ColumnSpacing="{StaticResource SpacingLarge}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Discovered" />
                                    <TextBlock Text="{Binding FilesDiscoveredText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Processed" />
                                    <TextBlock Text="{Binding FilesProcessedText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Data" />
                                    <TextBlock Text="{Binding BytesProcessedText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Elapsed" />
                                    <TextBlock Text="{Binding ElapsedText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="ETA" />
                                    <TextBlock Text="{Binding EtaText}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource PathTextBlockStyle}" Text="{Binding CurrentFilePath}" />
                            <Button
                                HorizontalAlignment="Right"
                                Command="{Binding CancelScanCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                                    <SymbolIcon Symbol="Cancel" />
                                    <TextBlock Text="Cancel" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
