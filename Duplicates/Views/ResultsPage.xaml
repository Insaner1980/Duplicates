<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duplicates.Views.ResultsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <CollectionViewSource
            x:Name="GroupedResults"
            IsSourceGrouped="True"
            ItemsPath="Files"
            Source="{Binding Groups}" />
    </Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="F"
            Modifiers="Control"
            Invoked="FocusSearch_Invoked" />
        <KeyboardAccelerator
            Key="Z"
            Modifiers="Control"
            Invoked="UndoSelection_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid Padding="24" Background="{ThemeResource BgBaseBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Small">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ResultsSplitView.DisplayMode" Value="Overlay" />
                        <Setter Target="ResultsSplitView.OpenPaneLength" Value="320" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ResultsSplitView.DisplayMode" Value="CompactOverlay" />
                        <Setter Target="ResultsSplitView.OpenPaneLength" Value="320" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Large">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1008" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ResultsSplitView.DisplayMode" Value="Inline" />
                        <Setter Target="ResultsSplitView.OpenPaneLength" Value="360" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{ThemeResource TitleTextBlockStyle}"
                Foreground="{ThemeResource TextPrimaryBrush}"
                Text="Results" />
            <TextBlock
                Style="{StaticResource MutedTextBlockStyle}"
                Text="{Binding SummaryText}" />
            <InfoBar
                AutomationProperties.LiveSetting="Polite"
                AutomationProperties.Name="Delete status"
                IsOpen="{Binding IsDeleteStatusOpen}"
                Message="{Binding DeleteStatusMessage}"
                Severity="Informational" />
            <StackPanel
                AutomationProperties.LiveSetting="Polite"
                Spacing="6"
                Visibility="{Binding DeleteProgressVisibility}">
                <TextBlock
                    Style="{StaticResource MutedTextBlockStyle}"
                    Text="{Binding DeleteProgressText}" />
                <ProgressBar Maximum="100" Value="{Binding DeleteProgressValue}" />
            </StackPanel>
            <Expander
                Header="Delete failures"
                Visibility="{Binding DeleteFailureDetailsVisibility}">
                <TextBlock
                    Style="{StaticResource PathTextBlockStyle}"
                    Text="{Binding DeleteFailureDetailsText}" />
            </Expander>
            <Expander
                Header="{Binding SkippedFilesSummaryText}"
                Visibility="{Binding SkippedFilesVisibility}">
                <TextBlock
                    Style="{StaticResource PathTextBlockStyle}"
                    Text="{Binding SkippedFilesDetailsText}" />
            </Expander>

            <Grid ColumnSpacing="{StaticResource SpacingMedium}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    Header="Search"
                    PlaceholderText="Filename or path"
                    QueryIcon="Find"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Grid.Column="1"
                    Header="Sort"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Reclaimable size" />
                    <ComboBoxItem Content="File size" />
                    <ComboBoxItem Content="Copies" />
                    <ComboBoxItem Content="File name" />
                    <ComboBoxItem Content="File type" />
                </ComboBox>
            </Grid>

            <CommandBar
                x:Name="ResultsCommandBar"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton
                    AccessKey="R"
                    Icon="Filter"
                    Label="Selection rule">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Keep newest" Command="{Binding AutoSelectKeepNewestCommand}" />
                            <MenuFlyoutItem Text="Keep oldest" Command="{Binding AutoSelectKeepOldestCommand}" />
                            <MenuFlyoutItem Text="Keep shortest path" Command="{Binding AutoSelectKeepShortestPathCommand}" />
                            <MenuFlyoutItem Text="Keep preferred folder" Click="KeepPreferredFolder_Click" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton
                    Icon="Clear"
                    Label="Clear selection"
                    Command="{Binding ClearSelectionCommand}" />
                <AppBarButton
                    Icon="Undo"
                    Label="Undo"
                    Command="{Binding UndoSelectionCommand}"
                    IsEnabled="{Binding CanUndoSelection}" />
                <AppBarToggleButton
                    AccessKey="P"
                    Icon="View"
                    Label="Preview"
                    IsChecked="{Binding IsPreviewPaneOpen, Mode=TwoWay}" />
                <AppBarSeparator />
                <AppBarButton
                    AccessKey="D"
                    Icon="Delete"
                    Label="{Binding DeleteButtonText}"
                    Foreground="{ThemeResource DangerBrush}"
                    IsEnabled="{Binding CanDelete}"
                    Click="Delete_Click" />
            </CommandBar>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{Binding BeforeFirstScanVisibility}">
                <FontIcon
                    FontSize="36"
                    Foreground="{ThemeResource AccentRedTextBrush}"
                    Glyph="&#xE8B6;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="Run a scan to see results" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{Binding NoDuplicatesVisibility}">
                <FontIcon
                    FontSize="36"
                    Foreground="{ThemeResource SuccessBrush}"
                    Glyph="&#xE73E;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="No duplicates found" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource MutedTextBlockStyle}"
                    Text="Every file in the scanned folders is unique." />
                <Button
                    Content="New scan"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="NewScan_Click" />
            </StackPanel>

            <SplitView
                x:Name="ResultsSplitView"
                DisplayMode="Inline"
                IsPaneOpen="{Binding IsPreviewPaneOpen, Mode=TwoWay}"
                OpenPaneLength="360"
                PanePlacement="Right"
                Visibility="{Binding ResultsVisibility}">
                <SplitView.Pane>
                    <ScrollViewer Padding="20,8,8,8">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Foreground="{ThemeResource TextPrimaryBrush}"
                                    Text="Preview" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Collapse preview pane"
                                    Command="{Binding TogglePreviewPaneCommand}"
                                    ToolTipService.ToolTip="Collapse preview pane">
                                    <SymbolIcon Symbol="Cancel" />
                                </Button>
                            </Grid>
                            <Image
                                MaxHeight="220"
                                AutomationProperties.Name="{Binding PreviewFileName}"
                                Stretch="Uniform"
                                Source="{Binding PreviewImage}"
                                Visibility="{Binding PreviewImageVisibility}" />
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontSize="56"
                                Foreground="{ThemeResource AccentRedTextBrush}"
                                Glyph="&#xE8A5;"
                                Visibility="{Binding PreviewMetadataVisibility}" />
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text="{Binding PreviewFileName}" />
                            <TextBlock
                                Style="{StaticResource PathTextBlockStyle}"
                                IsTextSelectionEnabled="True"
                                Text="{Binding PreviewPath}"
                                TextTrimming="None"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource MutedTextBlockStyle}"
                                Text="{Binding PreviewDetails}" />
                        </StackPanel>
                    </ScrollViewer>
                </SplitView.Pane>
                <SplitView.Content>
                    <ListView
                        x:Name="ResultsList"
                        AutomationProperties.Name="Duplicate files"
                        IsItemClickEnabled="False"
                        ItemsSource="{Binding Source={StaticResource GroupedResults}}"
                        SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="ContextFlyout">
                                    <Setter.Value>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Open" Click="OpenFile_Click" />
                                            <MenuFlyoutItem Text="Reveal in folder" Click="RevealFile_Click" />
                                            <MenuFlyoutItem Text="Copy path" Click="CopyPath_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem
                                                Text="Exclude from group"
                                                Command="{Binding ViewModel.ExcludeFileCommand, ElementName=PageRoot}"
                                                CommandParameter="{Binding}" />
                                            <MenuFlyoutItem
                                                Text="Delete file"
                                                Foreground="{ThemeResource DangerBrush}"
                                                Click="DeleteFile_Click" />
                                        </MenuFlyout>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid
                                            Padding="12,16,12,8"
                                            ColumnSpacing="{StaticResource SpacingMedium}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    AutomationProperties.HeadingLevel="Level2"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    Foreground="{ThemeResource TextPrimaryBrush}"
                                                    Text="{Binding DisplayName}" />
                                                <TextBlock
                                                    Style="{StaticResource MutedTextBlockStyle}"
                                                    Text="{Binding FilesSummaryText}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource DangerBrush}"
                                                Text="{Binding SelectedSummaryText}" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="8,6"
                                    ColumnSpacing="{StaticResource SpacingMedium}"
                                    ToolTipService.ToolTip="{Binding FullPath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Select file for deletion"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Foreground="{ThemeResource TextPrimaryBrush}"
                                            Text="{Binding FileName}" />
                                        <TextBlock
                                            Style="{StaticResource PathTextBlockStyle}"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            MaxLines="2"
                                            Text="{Binding DisplayDirectoryPath}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            Text="{Binding MetadataText}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        Visibility="{Binding KeptVisibility}">
                                        <SymbolIcon Symbol="Favorite" />
                                        <TextBlock
                                            Foreground="{ThemeResource AccentRedTextBrush}"
                                            Text="KEEP" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource DangerBrush}"
                                        Text="DELETE"
                                        Visibility="{Binding DeleteVisibility}" />
                                    <Button
                                        Grid.Column="3"
                                        AutomationProperties.Name="File actions"
                                        ToolTipService.ToolTip="File actions">
                                        <SymbolIcon Symbol="More" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Open" Click="OpenFile_Click" />
                                                <MenuFlyoutItem Text="Reveal in folder" Click="RevealFile_Click" />
                                                <MenuFlyoutItem Text="Copy path" Click="CopyPath_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem
                                                    Text="Exclude from group"
                                                    Command="{Binding ViewModel.ExcludeFileCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}" />
                                                <MenuFlyoutItem
                                                    Text="Delete file"
                                                    Foreground="{ThemeResource DangerBrush}"
                                                    Click="DeleteFile_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </SplitView.Content>
            </SplitView>
        </Grid>
    </Grid>
</Page>
