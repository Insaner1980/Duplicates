<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duplicates.Views.ResultsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <CollectionViewSource
            x:Name="GroupedResults"
            IsSourceGrouped="True"
            ItemsPath="Files"
            Source="{Binding Groups}" />
    </Page.Resources>

    <Grid Padding="24" Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <TextBlock
                Style="{ThemeResource TitleTextBlockStyle}"
                Foreground="{ThemeResource TextPrimaryBrush}"
                Text="Results" />
            <TextBlock
                Style="{StaticResource MutedTextBlockStyle}"
                Text="{Binding SummaryText}" />
            <InfoBar
                IsOpen="{Binding IsDeleteStatusOpen}"
                Message="{Binding DeleteStatusMessage}"
                Severity="Informational" />
            <StackPanel
                Spacing="6"
                Visibility="{Binding DeleteProgressVisibility}">
                <TextBlock
                    Style="{StaticResource MutedTextBlockStyle}"
                    Text="{Binding DeleteProgressText}" />
                <ProgressBar Maximum="100" Value="{Binding DeleteProgressValue}" />
            </StackPanel>
            <Expander
                Header="Delete failures"
                Visibility="{Binding DeleteFailureDetailsVisibility}">
                <TextBlock
                    Style="{StaticResource PathTextBlockStyle}"
                    Text="{Binding DeleteFailureDetailsText}" />
            </Expander>
            <Expander
                Header="{Binding SkippedFilesSummaryText}"
                Visibility="{Binding SkippedFilesVisibility}">
                <TextBlock
                    Style="{StaticResource PathTextBlockStyle}"
                    Text="{Binding SkippedFilesDetailsText}" />
            </Expander>

            <StackPanel Spacing="{StaticResource SpacingMedium}">
                <Grid ColumnSpacing="{StaticResource SpacingMedium}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Header="Search"
                        PlaceholderText="Filename or path"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox
                        Grid.Column="1"
                        Header="Sort"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Reclaimable size" />
                        <ComboBoxItem Content="File size" />
                        <ComboBoxItem Content="Copies" />
                        <ComboBoxItem Content="File name" />
                        <ComboBoxItem Content="File type" />
                    </ComboBox>
                </Grid>

                <Grid ColumnSpacing="{StaticResource SpacingMedium}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="{Binding SelectionRuleText}" />
                        <TextBlock
                            Style="{StaticResource MutedTextBlockStyle}"
                            Text="One file is kept in every group. The others are selected for deletion." />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpacingSmall}">
                        <Button>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                                <TextBlock Text="Selection rule" />
                                <FontIcon Glyph="&#xE70D;" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Keep newest" Command="{Binding AutoSelectKeepNewestCommand}" />
                                    <MenuFlyoutItem Text="Keep oldest" Command="{Binding AutoSelectKeepOldestCommand}" />
                                    <MenuFlyoutItem Text="Keep shortest path" Command="{Binding AutoSelectKeepShortestPathCommand}" />
                                    <MenuFlyoutItem Text="Keep preferred folder" Click="KeepPreferredFolder_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}" />
                        <Button
                            Content="Undo"
                            Command="{Binding UndoSelectionCommand}"
                            IsEnabled="{Binding CanUndoSelection}" />
                        <Button
                            AutomationProperties.Name="Toggle preview pane"
                            Command="{Binding TogglePreviewPaneCommand}"
                            ToolTipService.ToolTip="Toggle preview pane">
                            <SymbolIcon Symbol="View" />
                        </Button>
                        <Button
                            Content="{Binding DeleteButtonText}"
                            IsEnabled="{Binding CanDelete}"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Delete_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Border
                Style="{StaticResource CardBorderStyle}"
                Visibility="{Binding BeforeFirstScanVisibility}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        FontSize="36"
                        Foreground="{ThemeResource AccentRedTextBrush}"
                        Glyph="&#xE8B6;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="Run a scan to see results" />
                </StackPanel>
            </Border>

            <Border
                Style="{StaticResource CardBorderStyle}"
                Visibility="{Binding NoDuplicatesVisibility}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <FontIcon
                        FontSize="36"
                        Foreground="{ThemeResource SuccessBrush}"
                        Glyph="&#xE73E;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="No duplicates found" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource MutedTextBlockStyle}"
                        Text="Every file in the scanned folders is unique." />
                    <Button
                        Content="New scan"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="NewScan_Click" />
                </StackPanel>
            </Border>

            <Grid
                Visibility="{Binding ResultsVisibility}"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListView
                    x:Name="ResultsList"
                    AutomationProperties.Name="Duplicate files"
                    IsItemClickEnabled="False"
                    ItemsSource="{Binding Source={StaticResource GroupedResults}}"
                    SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="12,16,12,8"
                                        ColumnSpacing="{StaticResource SpacingMedium}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Foreground="{ThemeResource TextPrimaryBrush}"
                                                Text="{Binding DisplayName}" />
                                            <TextBlock
                                                Style="{StaticResource MutedTextBlockStyle}"
                                                Text="{Binding FilesSummaryText}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource DangerBrush}"
                                            Text="{Binding SelectedSummaryText}" />
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Padding="8,6"
                                ColumnSpacing="{StaticResource SpacingMedium}"
                                ToolTipService.ToolTip="{Binding FullPath}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Select file for deletion"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Foreground="{ThemeResource TextPrimaryBrush}"
                                        Text="{Binding FileName}" />
                                    <TextBlock
                                        Style="{StaticResource PathTextBlockStyle}"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        Text="{Binding DisplayDirectoryPath}" />
                                    <TextBlock
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextSecondaryBrush}"
                                        Text="{Binding MetadataText}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    Visibility="{Binding KeptVisibility}">
                                    <SymbolIcon Symbol="Favorite" />
                                    <TextBlock
                                        Foreground="{ThemeResource AccentRedTextBrush}"
                                        Text="KEEP" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource DangerBrush}"
                                    Text="DELETE"
                                    Visibility="{Binding DeleteVisibility}" />
                                <StackPanel
                                    Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button
                                        AutomationProperties.Name="Open file"
                                        Click="OpenFile_Click"
                                        ToolTipService.ToolTip="Open file">
                                        <SymbolIcon Symbol="OpenFile" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Reveal in folder"
                                        Click="RevealFile_Click"
                                        ToolTipService.ToolTip="Reveal in folder">
                                        <SymbolIcon Symbol="Folder" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Copy path"
                                        Click="CopyPath_Click"
                                        ToolTipService.ToolTip="Copy path">
                                        <SymbolIcon Symbol="Copy" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Delete file"
                                        Click="DeleteFile_Click"
                                        Foreground="{ThemeResource DangerBrush}"
                                        ToolTipService.ToolTip="Delete this file">
                                        <SymbolIcon Symbol="Delete" />
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Exclude from group"
                                        Command="{Binding ViewModel.ExcludeFileCommand, ElementName=PageRoot}"
                                        CommandParameter="{Binding}"
                                        ToolTipService.ToolTip="Exclude from group">
                                        <SymbolIcon Symbol="Remove" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border
                    Grid.Column="1"
                    Width="360"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding PreviewPaneVisibility}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Foreground="{ThemeResource TextPrimaryBrush}"
                                Text="Preview" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Collapse preview pane"
                                Command="{Binding TogglePreviewPaneCommand}">
                                <SymbolIcon Symbol="Cancel" />
                            </Button>
                        </Grid>
                        <Image
                            MaxHeight="220"
                            Stretch="Uniform"
                            Source="{Binding PreviewImage}"
                            Visibility="{Binding PreviewImageVisibility}" />
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="56"
                            Foreground="{ThemeResource AccentRedTextBrush}"
                            Glyph="&#xE8A5;"
                            Visibility="{Binding PreviewMetadataVisibility}" />
                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Text="{Binding PreviewFileName}" />
                        <TextBlock
                            Style="{StaticResource PathTextBlockStyle}"
                            Text="{Binding PreviewPath}" />
                        <TextBlock
                            Style="{StaticResource MutedTextBlockStyle}"
                            Text="{Binding PreviewDetails}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
