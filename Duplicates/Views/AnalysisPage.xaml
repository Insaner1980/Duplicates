<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duplicates.Views.AnalysisPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Duplicates.Views.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <Grid Background="{ThemeResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <Grid
                MaxWidth="{StaticResource ContentMaxWidth}"
                Padding="{StaticResource ScrollingPageContentPadding}"
                HorizontalAlignment="Stretch">
                <StackPanel Spacing="{StaticResource SpacingExtraLarge}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource MutedTextBlockStyle}" Text="{Binding Subtitle}" />
                    </StackPanel>

                    <InfoBar
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="Analysis status"
                        IsOpen="{Binding IsStatusOpen}"
                        Message="{Binding StatusMessage}"
                        Severity="{Binding StatusSeverity}" />

                    <StackPanel Visibility="{Binding SetupVisibility}" Spacing="{StaticResource SpacingExtraLarge}">
                        <controls:PathScopeEditor
                            x:Name="PathScopeEditor"
                            DataContext="{Binding PathScope}" />
                        <toolkit:SettingsExpander
                            x:Name="AnalysisOptions"
                            Header="Analysis options"
                            Description="{Binding OptionsSummary}"
                            IsExpanded="True"
                            Visibility="{Binding OptionsVisibility}">
                            <toolkit:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE71C;" />
                            </toolkit:SettingsExpander.HeaderIcon>
                            <toolkit:SettingsExpander.Items>
                                <toolkit:SettingsCard
                                    Header="Minimum size"
                                    Description="Smaller files are skipped."
                                    Visibility="{Binding LargeFileOptionsVisibility}">
                                    <StackPanel Spacing="{StaticResource SpacingSmall}">
                                        <controls:ByteSizeBox
                                            AccessibleName="Minimum size"
                                            DataContext="{Binding LargeFileMinimumSizeEditor}" />
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                                            <Button
                                                Command="{Binding SetLargeFileMinimumSizeToAnyCommand}"
                                                Content="Any" />
                                            <Button
                                                Command="{Binding SetLargeFileMinimumSizeTo100MbCommand}"
                                                Content="100 MB" />
                                            <Button
                                                Command="{Binding SetLargeFileMinimumSizeTo1GbCommand}"
                                                Content="1 GB" />
                                            <Button
                                                Command="{Binding SetLargeFileMinimumSizeTo10GbCommand}"
                                                Content="10 GB" />
                                        </StackPanel>
                                    </StackPanel>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard
                                    Header="Minimum age"
                                    Description="In days. Newer files are skipped."
                                    Visibility="{Binding TemporaryFileOptionsVisibility}">
                                    <NumberBox
                                        MinWidth="200"
                                        AutomationProperties.Name="Minimum age, days"
                                        Minimum="0"
                                        SpinButtonPlacementMode="Compact"
                                        ValidationMode="InvalidInputOverwritten"
                                        Value="{Binding TemporaryFileMinimumAgeDays, Mode=TwoWay}" />
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard
                                    Header="Image similarity"
                                    Description="Strict finds closer matches. Broad finds more candidates."
                                    Visibility="{Binding SimilarImageOptionsVisibility}">
                                    <ComboBox
                                        MinWidth="200"
                                        AutomationProperties.Name="Image similarity"
                                        SelectedIndex="{Binding ImageSimilarityPresetIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Strict" />
                                        <ComboBoxItem Content="Balanced" />
                                        <ComboBoxItem Content="Broad" />
                                    </ComboBox>
                                </toolkit:SettingsCard>
                                <toolkit:SettingsCard
                                    Header="Video similarity"
                                    Description="Strict finds closer matches. Broad finds more candidates."
                                    Visibility="{Binding SimilarVideoOptionsVisibility}">
                                    <ComboBox
                                        MinWidth="200"
                                        AutomationProperties.Name="Video similarity"
                                        SelectedIndex="{Binding VideoSimilarityPresetIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Strict" />
                                        <ComboBoxItem Content="Balanced" />
                                        <ComboBoxItem Content="Broad" />
                                    </ComboBox>
                                </toolkit:SettingsCard>
                            </toolkit:SettingsExpander.Items>
                        </toolkit:SettingsExpander>
                        <toolkit:SettingsCard
                            Header="Nothing changes until you choose"
                            Description="The analysis only reads files. You review the results before anything is renamed, moved, or deleted.">
                            <toolkit:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE946;" />
                            </toolkit:SettingsCard.HeaderIcon>
                        </toolkit:SettingsCard>
                    </StackPanel>

                    <StackPanel
                        AutomationProperties.LiveSetting="Polite"
                        Visibility="{Binding ProgressVisibility}"
                        Spacing="{StaticResource SpacingLarge}">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource SectionHeaderTextBlockStyle}"
                            Text="{Binding PhaseText}" />
                        <ProgressBar
                            Maximum="100"
                            IsIndeterminate="{Binding IsProgressIndeterminate}"
                            Value="{Binding ProgressValue}" />
                        <VariableSizedWrapGrid Orientation="Horizontal">
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Discovered" />
                                <TextBlock Text="{Binding ItemsDiscoveredText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Processed" />
                                <TextBlock Text="{Binding ItemsProcessedText}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,24,12">
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="Data" />
                                <TextBlock Text="{Binding BytesProcessedText}" />
                            </StackPanel>
                        </VariableSizedWrapGrid>
                        <TextBlock Style="{StaticResource PathTextBlockStyle}" Text="{Binding CurrentPath}" />
                        <Button
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Cancel analysis"
                            Command="{Binding CancelAnalysisCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                                <SymbolIcon Symbol="Cancel" />
                                <TextBlock Text="Cancel" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="ActionFooter"
            Grid.Row="1"
            Style="{StaticResource PageFooterBorderStyle}"
            Visibility="{Binding SetupVisibility}">
            <Grid
                MaxWidth="{StaticResource ContentMaxWidth}"
                HorizontalAlignment="Stretch"
                ColumnSpacing="{StaticResource SpacingLarge}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource MutedTextBlockStyle}"
                    Text="Add at least one folder or file to start."
                    Visibility="{Binding PathScope.EmptyIncludedPathsVisibility}" />
                <Button
                    Grid.Column="1"
                    AccessKey="S"
                    AutomationProperties.Name="Start analysis"
                    Command="{Binding StartAnalysisCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                        <SymbolIcon Symbol="Play" />
                        <TextBlock Text="Start analysis" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>
