<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <Thickness x:Key="SettingsCardBorderThickness">0</Thickness>
    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
    <x:Double x:Key="SpacingSmall">8</x:Double>
    <x:Double x:Key="SpacingMedium">12</x:Double>
    <x:Double x:Key="SpacingLarge">16</x:Double>
    <x:Double x:Key="SpacingExtraLarge">24</x:Double>
    <x:Double x:Key="ContentMaxWidth">1040</x:Double>
    <x:Double x:Key="FolderListMaxHeight">220</x:Double>
    <Thickness x:Key="PageHeaderPadding">32,24,32,20</Thickness>
    <Thickness x:Key="PageContentPadding">32,0,32,32</Thickness>
    <Thickness x:Key="ScrollingPageContentPadding">32,24,32,32</Thickness>
    <Thickness x:Key="PageFooterPadding">32,12,32,24</Thickness>

    <Style x:Key="PageFooterBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource BgBaseBrush}" />
    </Style>

    <Style TargetType="toolkit:SettingsExpander">
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style TargetType="toolkit:SettingsCard">
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>

    <Style
        x:Key="SectionHeaderTextBlockStyle"
        BasedOn="{StaticResource BodyStrongTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="MutedTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PathTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>
